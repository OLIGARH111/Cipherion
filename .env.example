# Export these variables in your shell or run node --env-file=.env server/index.js
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set only behind a trusted reverse proxy such as Render so HTTPS origins work.
TRUST_PROXY=0
# Set to the exact public HTTPS origin behind your reverse proxy.
# PUBLIC_ORIGIN=https://chat.example.com
# COOKIE_SECURE=1
# TURN is required for reliable calls across restrictive networks.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
# Optional OpenAI-compatible transcription service. Audio leaves your server only on explicit request.
# TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_KEY=
# TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Optional real Responses-compatible AI provider. No API calls until the user enables AI.
# Use your own/free provider and actual model ID; never commit credentials.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_MODELS=
# CHILD_AI_ENABLED=0

# Real external Coturn service. Shared secret stays on the server.
# TURN_URLS=
# TURN_SHARED_SECRET=
# Managed TURN without your own Coturn (pick one). Needed for calls over mobile data / CGNAT.
# Cloudflare Realtime: dash.cloudflare.com → Realtime → TURN → Create key.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Metered: METERED_TURN_DOMAIN=yourapp.metered.live and the API key from the dashboard.
# METERED_TURN_DOMAIN=
# METERED_TURN_API_KEY=


# Comma-separated immutable user IDs with VIP/catalog administrative privileges.
# No account is an administrator by default. Never use a browser setting for this.
ADMIN_USER_IDS=
# Global ceiling on AI requests across all users per UTC day (existing per-user quotas also apply).
AI_DAILY_REQUEST_BUDGET=1000


# Optional private admin enrollment. Never commit the original code.
ADMIN_CLAIM_USERNAME=
ADMIN_CLAIM_HASH=
# Optional verification delivery webhook (HTTPS), server-to-server only.
EMAIL_VERIFICATION_URL=
SMS_VERIFICATION_URL=
VERIFICATION_TOKEN=


# Web Push: optional override. Without keys, one stable pair is generated in the database.
# To manage keys explicitly: npx web-push generate-vapid-keys
# Set BOTH keys; retain the same pair across deploys.
# Preserve this key pair across deploys. Never put the private key in public assets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Must fit the actual persistent disk / upload proxy limits.
MAX_UPLOAD_MB=64
# Optional: chat-completions for rewrite providers; Groq is detected automatically.
AI_API_STYLE=responses


# External database (server only). Set BOTH values to select Turso.
# Configure these only at cutover, after verified backup/import.
# TURSO_DATABASE_URL=libsql://cipherion-oligarh111.aws-us-west-2.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_ALLOW_EMPTY_INIT=1  # only for an explicitly approved NEW empty database


# October update: private S3-compatible object storage.
# Docker currently opts into temporary local uploads for the interim release.
# Set durable after verifying S3. Temporary uploads can be lost on Render restart/deploy.
MEDIA_STORAGE_MODE=durable
# Keep these server-side. Existing /api/media URLs remain authorization-checked.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0

# Enable only after nullable-username migration and a verified real mail delivery test.
EMAIL_AUTH_ENABLED=0
# Stable random secret of at least 32 characters, distinct from mail/provider credentials.
EMAIL_CODE_SECRET=
# EMAIL_VERIFICATION_URL above must accept {to,code,kind,purpose,expiresIn} over HTTPS.
# VERIFICATION_TOKEN above authenticates the server-to-server delivery request.
# Offline migration backup location; never put backups under public/ or commit them.
# EMAIL_MIGRATION_BACKUP=/secure-backups/cipherion-before-email.json
# NODE_ENV=development enables WebRTC diagnostics. Never enable on production.
# Alternative to an external mail webhook: direct Resend HTTPS API delivery.
# Use a verified sender/domain; the provider's test sender cannot serve all users.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Cipherion <auth@your-domain.example>
# EMAIL_PROVIDER=webhook remains the default when omitted.
